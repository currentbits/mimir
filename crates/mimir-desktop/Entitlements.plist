<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Notarized apps run with the hardened runtime, which blocks the microphone unless it's declared here: meetings
       record your side of a call. (The call's other side, the computer's sound, needs no entitlement.) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
